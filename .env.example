# Copy to .env and fill in. Only ONEREAD_SECRET_KEY is required.

# Signs session cookies. Leave it blank and one is generated into
# $ONEREAD_DATA_DIR/secret.key on first run and reused after that, so restarts
# don't sign everyone out. Set it here to keep the key out of the data
# directory, or to share one across several machines:
#   openssl rand -base64 48
# Changing it signs everyone out.
ONEREAD_SECRET_KEY=

# Set to true once the app is behind HTTPS.
ONEREAD_COOKIE_SECURE=false

# Comma-separated host names the app will answer to. Leave as * for local use.
ONEREAD_ALLOWED_HOSTS=*

# Ceiling on a request body, uploads aside (those have their own, larger limit
# below). A 100k-character entry fits inside this several times over.
ONEREAD_MAX_REQUEST_BYTES=2097152

# Turn off once your people have accounts, and new user ids stop working.
ONEREAD_ALLOW_REGISTRATION=true

# Where the database and wav files live.
ONEREAD_DATA_DIR=./data

# Ceilings, per entry and per user. 100k characters is roughly two hours of
# audio and takes around half an hour of CPU to generate.
ONEREAD_MAX_TEXT_CHARS=100000

# Uploads. Anything bigger than the first is turned away before it's read.
# Office files are zip archives, so the second caps what one is allowed to
# become once unpacked — otherwise a 2 MB file can fill the disk.
ONEREAD_MAX_UPLOAD_BYTES=26214400
ONEREAD_MAX_UNZIPPED_BYTES=209715200
ONEREAD_UPLOAD_PER_HOUR=60

# The 1990s .doc and .ppt formats have no Python reader worth trusting, so
# they're passed through LibreOffice when there is one. Leave this empty and
# they're turned away with a note to save the file as .docx or .pptx instead.
# Everything else — including .xls — is read without it.
ONEREAD_SOFFICE_PATH=

# How much of a new entry gets read straight away, and the lengths on offer.
# The full reading is always a separate, deliberate press.
ONEREAD_SAMPLE_MINUTES=1
ONEREAD_SAMPLE_MINUTE_CHOICES=1,3,5
ONEREAD_GENERATE_PER_HOUR=30
ONEREAD_MAX_QUEUED_PER_USER=3
ONEREAD_LOGIN_PER_MINUTE=10

# Sign-in attempts are counted twice: once against the address the request
# claims (X-Forwarded-For, which the caller writes and can change at will) and
# once against the address that actually opened the connection, which it can't.
# The second allowance is this multiple of the first, because behind a reverse
# proxy every visitor arrives on the same connection address and shares it.
# Raise it if a busy shared proxy starts hitting the ceiling.
ONEREAD_LOGIN_PEER_FACTOR=5

# Wrong passwords for one user id per minute, from anywhere. Both limits above
# are keyed on an address, and an address can be rewritten (uvicorn will do it
# itself from X-Forwarded-For unless it's run with --no-proxy-headers, which the
# Dockerfile and Makefile both do). The account being guessed at can't be, so
# this is the limit that actually bounds password guessing.
#
# It is consulted only when an attempt is wrong, so it can't be used to lock
# someone out: the right password is never measured against it.
ONEREAD_LOGIN_FAILURES_PER_MINUTE=10

# Sessions last a month, and using the app renews one that's older than a day.
ONEREAD_SESSION_MAX_AGE_S=2592000
ONEREAD_SESSION_REFRESH_AFTER_S=86400

# Synthesis quality. More steps sound slightly better and take longer.
ONEREAD_TTS_STEPS=8

# Load the model at startup instead of on the first entry.
ONEREAD_PRELOAD_MODEL=true
