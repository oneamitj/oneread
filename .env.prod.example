# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   $EDITOR .env.prod
#   make prod-init
#
# .env.prod is gitignored. Keep it that way — ONEREAD_SECRET_KEY is in it.

# --- required -----------------------------------------------------------------

# The name this is served under. Its A (and AAAA, if you have one) record must
# already point at this host before `make prod-init` runs, because Let's Encrypt
# proves ownership by fetching a file from it over http.
#
# It is also ONEREAD_ALLOWED_HOSTS: the app answers to this name and refuses
# every other Host header.
ONEREAD_DOMAIN=oneread.amitj.me

# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
CERTBOT_EMAIL=info@amitj.me

# Signs session cookies. Leave blank and one is generated into
# data/secret.key on first run and reused, which is fine for a single
# container. Set it to keep the key out of the data directory:
#   openssl rand -base64 48
# Changing it signs everyone out.
ONEREAD_SECRET_KEY=

# --- certificates -------------------------------------------------------------

# Set to 1 for the first run against a new domain. Let's Encrypt allows five
# failed attempts per hostname per hour on the real endpoint and the staging one
# is effectively unlimited, so a typo costs nothing there and locks you out for
# an hour here. The certificate it issues is untrusted by browsers, which is the
# point: it proves the plumbing works, then you set this back to 0 and rerun.
CERTBOT_STAGING=0

# --- accounts -----------------------------------------------------------------

# Leave true until the people who need accounts have made them, then set it to
# false and `make prod-update`. New user ids stop working; existing ones keep
# signing in.
ONEREAD_ALLOW_REGISTRATION=true

# --- limits and resources -----------------------------------------------------

# Synthesis is CPU-bound and runs on one thread behind one worker. More cores
# here means faster audio up to a point; more memory only matters if entries are
# very long.
ONEREAD_CPUS=4.0
ONEREAD_MEMORY=7g

# 100k characters is roughly two hours of audio and about half an hour of CPU.
ONEREAD_MAX_TEXT_CHARS=100000

# Raise this and you must raise `client_max_body_size` in
# deploy/nginx/nginx.conf to match, or nginx refuses what the app would accept.
ONEREAD_MAX_UPLOAD_BYTES=26214400

ONEREAD_GENERATE_PER_HOUR=30
ONEREAD_LOGIN_PER_MINUTE=10

# Load the model at startup rather than on the first entry. Costs about ninety
# seconds of start-up, saves the first reader the same ninety seconds.
ONEREAD_PRELOAD_MODEL=true

# Other origins allowed to call the API from a browser. Almost certainly leave
# this empty: the frontend is served from the same origin as the API. The app
# refuses "*" and won't start with it.
ONEREAD_CORS_ORIGINS=
