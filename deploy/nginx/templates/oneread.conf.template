# Rendered into /etc/nginx/conf.d/oneread.conf at container start with
# ${ONEREAD_DOMAIN} substituted. NGINX_ENVSUBST_FILTER=ONEREAD_ is what keeps
# envsubst's hands off nginx's own $host, $remote_addr and friends.

upstream oneread_app {
    # A fixed address rather than the service name on purpose. nginx resolves an
    # upstream host once at startup and caches it forever, so `app:8000` points
    # at a dead address the first time the app container is recreated with a new
    # IP. The address is pinned in docker-compose.prod.yml; change it there and
    # here together.
    server 10.83.7.20:8000 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

# --- anything that isn't our name --------------------------------------------
#
# Scanners find the address long before anyone finds the name. They get nothing
# back: 444 closes the connection with no response at all on http, and on https
# the handshake is rejected before a certificate is even offered, so this host
# never confirms which name it holds.

server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# --- http: the certificate dance, and then go away ---------------------------

server {
    listen 80;
    server_name ${ONEREAD_DOMAIN};

    # certbot writes its proof here and Let's Encrypt reads it over plain http.
    # This is the one thing port 80 is for, and it stays reachable forever
    # because renewal uses the same path every sixty days.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    # 308 rather than 301: it keeps the method and body, so a POST that arrived
    # on http is retried as a POST. The destination is spelled out instead of
    # built from $host, which cannot be trusted to be this name.
    location / {
        return 308 https://${ONEREAD_DOMAIN}$request_uri;
    }
}

# --- https: the actual site ---------------------------------------------------

server {
    listen 443 ssl;
    http2 on;
    server_name ${ONEREAD_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ONEREAD_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ONEREAD_DOMAIN}/privkey.pem;

    # TLS 1.2 and 1.3 only, forward secrecy only, AEAD only. No DHE, which is
    # why there is no dhparam file anywhere in this repo to go stale.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    # Off because the ticket key would live in this process's memory for its
    # whole life, and anyone who later gets it can decrypt recorded sessions.
    # Resumption still works within a worker through the cache above.
    ssl_session_tickets off;

    # No OCSP stapling: Let's Encrypt stopped serving OCSP responses, so
    # `ssl_stapling on` here would do nothing but log a failure every hour.

    # The app sets its own Content-Security-Policy, X-Frame-Options,
    # Referrer-Policy and the rest, and those pass through untouched — one
    # implementation, in the code, where the tests can see it.
    #
    # HSTS is the exception, and it is done this way rather than left to the app
    # so that it is also on the responses nginx produces by itself: a 502 while
    # the app is restarting, a 429 from the limits below, a 413 on an oversized
    # body. Hiding the upstream copy first is what stops the header arriving
    # twice. No `preload` — that is a one-way door and belongs to whoever owns
    # the domain, not to this file.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Renewal reaches this name over http, but keep the path answering here too
    # so a redirect loop or an http-blocking middlebox can't strand a renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    location = /healthz {
        access_log off;
        include /etc/nginx/proxy_common.conf;
        proxy_pass http://oneread_app;
    }

    # The three prefixes below end without a slash, and that is load-bearing
    # rather than a style choice. A prefix location that ends in `/` and proxies
    # gets special treatment from nginx: a request for the prefix *without* the
    # slash is answered by nginx's own 301 to the slashed form, and never
    # reaches the app. A browser following that 301 turns a POST into a GET and
    # drops the body, so `POST /api/uploads` arrived as `GET /api/uploads/`, was
    # answered with the React shell, and every upload failed in production while
    # working locally — where there is no nginx in the way. So a prefix that is
    # itself a route is written without the slash. Don't put them back.
    #
    # `/api/` below keeps its slash because bare `/api` is nobody's route: the
    # redirect can happen there and there is nothing for it to break.
    #
    # Sign-in. The app already counts attempts three ways — per claimed address,
    # per real peer, and per user id — so this is only here to keep a password
    # flood off the single worker in the first place. `nodelay` lets a burst of
    # honest retries through immediately and only then starts refusing.
    location ^~ /api/auth {
        limit_req  zone=auth burst=10 nodelay;
        limit_conn conn 16;
        include /etc/nginx/proxy_common.conf;
        proxy_pass http://oneread_app;
    }

    # Audio. An hour of speech is around 300 MB, so this is the one path where
    # buffering the whole response before sending a byte would be actively
    # wrong: it would land in the 512 MB tmpfs cache and stall the download for
    # as long as it took to fill. Streamed straight through instead. The app
    # serves these asynchronously, so a slow client costs a task, not a thread.
    location ^~ /api/renditions {
        limit_req  zone=api burst=60 nodelay;
        proxy_buffering off;
        include /etc/nginx/proxy_common.conf;
        proxy_pass http://oneread_app;
    }

    # Uploads. Request buffering stays on (the default) so nginx holds the whole
    # 25 MB before the app is troubled with it — a slow upload occupies nginx,
    # which has workers to spare, rather than the one process doing synthesis.
    #
    # This is the block the trailing-slash note above is about: the route is
    # `POST /api/uploads`, with no path component to hide the problem.
    location ^~ /api/uploads {
        limit_req  zone=api burst=20 nodelay;
        limit_conn conn 8;
        include /etc/nginx/proxy_common.conf;
        proxy_pass http://oneread_app;
    }

    location ^~ /api/ {
        limit_req  zone=api burst=120 nodelay;
        limit_conn conn 32;
        include /etc/nginx/proxy_common.conf;
        proxy_pass http://oneread_app;
    }

    # The Vite build and the SPA fallback, both served by the app itself.
    location / {
        limit_conn conn 32;
        include /etc/nginx/proxy_common.conf;
        proxy_pass http://oneread_app;
    }
}
