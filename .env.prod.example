# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   $EDITOR .env.prod
#   make prod-init
#
# .env.prod is gitignored. Keep it that way — ONEREAD_SECRET_KEY is in it.

# --- required -----------------------------------------------------------------

# The name this is served under. Its A (and AAAA, if you have one) record must
# already point at this host before `make prod-init` runs, because Let's Encrypt
# proves ownership by fetching a file from it over http.
#
# It is also ONEREAD_ALLOWED_HOSTS: the app answers to this name and refuses
# every other Host header.
ONEREAD_DOMAIN=oneread.amitj.me

# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
CERTBOT_EMAIL=info@amitj.me

# Signs session cookies. Leave blank and one is generated into
# data/secret.key on first run and reused, which is fine for a single
# container. Set it to keep the key out of the data directory:
#   openssl rand -base64 48
# Changing it signs everyone out.
ONEREAD_SECRET_KEY=

# --- certificates -------------------------------------------------------------

# Set to 1 for the first run against a new domain. Let's Encrypt allows five
# failed attempts per hostname per hour on the real endpoint and the staging one
# is effectively unlimited, so a typo costs nothing there and locks you out for
# an hour here. The certificate it issues is untrusted by browsers, which is the
# point: it proves the plumbing works, then you set this back to 0 and rerun.
CERTBOT_STAGING=0

# --- being found ---------------------------------------------------------------

# Whether this instance should show up in search results and in what assistants
# say when someone asks about self-hosted text-to-speech. True turns robots.txt
# from "go away" into a real one with a sitemap, drops the noindex from /about,
# and lets the crawlers listed in backend/oneread/routers/site.py through. Leave
# it false on a private instance and none of that happens.
ONEREAD_PUBLIC_SITE=true

# The full address, scheme and all. Used for the canonical link, the sitemap and
# the absolute URLs in link previews, none of which can be guessed from a Host
# header the caller wrote. Normally https:// plus ONEREAD_DOMAIN.
ONEREAD_PUBLIC_URL=https://oneread.amitj.me

# --- accounts -----------------------------------------------------------------

# Leave true until the people who need accounts have made them, then set it to
# false and `make prod-update`. New user ids stop working; existing ones keep
# signing in.
ONEREAD_ALLOW_REGISTRATION=true

# The cookieless headcount: page views, unique visitors, signups and sign-ins,
# four integers per UTC day, printed by `make stats`. It sets no cookie, stores
# nothing in the browser, and never writes an address down — addresses are
# hashed under a random key made in memory and destroyed at midnight — which is
# why it runs without asking anyone. Set it to false and the table stays empty.
# (Microsoft Clarity is the separate thing, and it does ask; see the README.)
ONEREAD_COUNT_VISITS=true
# How long a crash can cost: the counts live in memory between writes.
ONEREAD_VISITS_FLUSH_INTERVAL_S=60

# --- limits and resources -----------------------------------------------------

# Synthesis is CPU-bound and runs on one thread behind one worker. More cores
# here means faster audio up to a point; more memory only matters if entries are
# very long.
ONEREAD_CPUS=4.0
ONEREAD_MEMORY=7g

# 100k characters is roughly two hours of audio and about half an hour of CPU.
ONEREAD_MAX_TEXT_CHARS=100000

# Raise this and you must raise `client_max_body_size` in
# deploy/nginx/nginx.conf to match, or nginx refuses what the app would accept.
ONEREAD_MAX_UPLOAD_BYTES=26214400

ONEREAD_GENERATE_PER_HOUR=30
ONEREAD_LOGIN_PER_MINUTE=10

# Load the model at startup rather than on the first entry. Costs about ninety
# seconds of start-up, saves the first reader the same ninety seconds.
ONEREAD_PRELOAD_MODEL=true

# Pacing. A paragraph is read through: a full stop inside one earns a breath.
# A line of its own — a list item, an address, a line of verse — earns more,
# and a blank line earns most. The model's own trailing silence is
# trimmed off each piece first, so these are the pauses actually heard.
ONEREAD_SILENCE_BETWEEN_SENTENCES_S=0.15
ONEREAD_SILENCE_BETWEEN_LINES_S=0.35
ONEREAD_SILENCE_BETWEEN_BLOCKS_S=0.55
ONEREAD_TRIM_SEGMENT_SILENCE=true

# How much the stack says for itself. There is no access log on either nginx or
# uvicorn in this file, so at ERROR the only lines in `docker compose logs` are
# things that went wrong. WARNING adds the near-misses (a synthesis retried, a
# file refused); INFO adds the running commentary. DEBUG is for a bug you're
# chasing, not for leaving on.
ONEREAD_LOG_LEVEL=ERROR
# uvicorn keeps its own logger, so its startup and shutdown lines have their own
# switch. `info` here is what brings back "Application startup complete".
ONEREAD_UVICORN_LOG_LEVEL=error

# Other origins allowed to call the API from a browser. Almost certainly leave
# this empty: the frontend is served from the same origin as the API. The app
# refuses "*" and won't start with it.
ONEREAD_CORS_ORIGINS=
